<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.selran.hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/selran-hub/run_hub.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/you/Library/Logs/selran-hub.log</string>
  <key>StandardErrorPath</key><string>/Users/you/Library/Logs/selran-hub.log</string>
</dict>
</plist>
